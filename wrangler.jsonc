{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "gloomberb-cloud",
  "main": "src/renderers/cloudflare/worker.ts",
  "compatibility_date": "2026-08-15",
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "assets": {
    "directory": "./dist/web-client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "gloomberb-cloud",
      "database_id": "95f74fbd-07f5-4732-8ab7-3d0f42588dda",
      "migrations_dir": "migrations/cloudflare"
    }
  ]
}
